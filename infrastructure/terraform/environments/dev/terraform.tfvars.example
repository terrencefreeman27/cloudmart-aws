# Copy this file to terraform.tfvars to override the defaults in variables.tf.
# terraform.tfvars is gitignored — this .example file documents the expected
# shape but never contains secrets. No AWS credentials belong in any .tf or
# .tfvars file — see docs/decisions/0004-aws-authentication-via-iam-identity-center.md.

aws_region  = "us-east-1"
aws_profile = "cloudmart"
project     = "cloudmart"
environment = "dev"

vpc_cidr              = "10.0.0.0/16"
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs  = ["10.0.11.0/24", "10.0.12.0/24"]

instance_type = "t2.micro"

# Leave commented out by default — no ingress rule is created at all when
# this is empty/unset, which is the safe default (use SSM port forwarding
# instead). Only uncomment locally in your OWN terraform.tfvars (this
# .example file stays committed, terraform.tfvars does not) if you want
# temporary direct access, and use YOUR real IP, not the placeholder below.
# 203.0.113.0/24 shown here is IANA's reserved documentation range (RFC
# 5737) — never a real address, safe to leave in a public repo.
# allowed_demo_cidrs = ["203.0.113.7/32"]
