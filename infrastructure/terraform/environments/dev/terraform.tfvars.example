# Copy this file to terraform.tfvars to override the defaults in variables.tf.
# terraform.tfvars is gitignored — this .example file documents the expected
# shape but never contains secrets. No AWS credentials belong in any .tf or
# .tfvars file — see docs/decisions/0004-aws-authentication-via-iam-identity-center.md.

aws_region  = "us-east-1"
aws_profile = "cloudmart"
project     = "cloudmart"
environment = "dev"

vpc_cidr              = "10.0.0.0/16"
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs  = ["10.0.11.0/24", "10.0.12.0/24"]

instance_type = "t2.micro"

# false = Single-AZ (~$15.84/mo if deployed). true = Multi-AZ, synchronous
# standby + automatic failover (~$31.28/mo if deployed) — only flip this
# with explicit approval to pay for it. See docs/decisions/0008.
db_multi_az = false

# Leave blank by default — no SNS email subscription is created, alarms
# still work (visible in the CloudWatch console) without one. Only set
# this in your OWN terraform.tfvars (this .example file stays committed,
# terraform.tfvars does not) — never commit a real email address here.
# monitoring_notification_email = "you@example.com"
